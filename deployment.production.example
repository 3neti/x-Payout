# x-PayOut production deployment control worksheet
#
# Copy this file to deployment.production.local. The destination is gitignored.
# This is not a Laravel application .env and must never contain production
# credentials. Secret values belong exclusively in Laravel Cloud managed
# secrets; this worksheet records only their names and Cloud secret IDs.

# -----------------------------------------------------------------------------
# Deployment control plane — consumed by scripts/deploy-production-cleanroom.sh
# and never copied into the Laravel runtime environment.
# -----------------------------------------------------------------------------
DEPLOY_CONFIRM_PRODUCTION=NO
DEPLOY_CONFIRM_COMMISSIONING=NO
DEPLOY_CONFIRM_DOMAIN_CUTOVER=NO

DEPLOY_CLOUD_APPLICATION_NAME=x-PayOut
DEPLOY_CLOUD_APPLICATION_ID=
DEPLOY_CLOUD_ENVIRONMENT_NAME=production
DEPLOY_CLOUD_ENVIRONMENT_ID=
DEPLOY_CLOUD_INSTANCE_ID=
DEPLOY_CLOUD_DATABASE_CLUSTER_ID=
DEPLOY_CLOUD_DATABASE_ID=
DEPLOY_CLOUD_CACHE_ID=
DEPLOY_CLOUD_WORKER_PROCESS_ID=
DEPLOY_CLOUD_DOMAIN_ID=
DEPLOY_DOMAIN_VERIFY_ATTEMPTS=12
DEPLOY_DOMAIN_VERIFY_INTERVAL_SECONDS=5
DEPLOY_CLOUD_SECRET_IDS=
DEPLOY_REQUIRED_CLOUD_SECRET_NAMES=AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY,ENGAGESPARK_API_KEY,ENGAGESPARK_ORGANIZATION_ID,TXTCMDR_API_TOKEN,HYPERVERGE_APP_ID,HYPERVERGE_APP_KEY,MAPBOX_TOKEN,OPENCAGE_API_KEY,NETBANK_CLIENT_ID,NETBANK_CLIENT_SECRET,NETBANK_FUNDING_CLIENT_ID,NETBANK_FUNDING_CLIENT_SECRET,NETBANK_FUNDING_STANDING_HMAC_KEY,XCHANGE_COMMISSIONING_ACCESS_TOKEN,XCHANGE_REDEMPTION_FEEDBACK_WEBHOOK_SECRET

DEPLOY_GIT_REPOSITORY=3neti/x-Payout
DEPLOY_GIT_BRANCH=main
DEPLOY_CLOUD_REGION=ap-southeast-1
DEPLOY_DATABASE_TYPE=neon_serverless_postgres
DEPLOY_DATABASE_ENGINE_VERSION=18
DEPLOY_CACHE_TYPE=laravel_valkey
DEPLOY_CACHE_SIZE=valkey-pro.250mb
DEPLOY_CACHE_EVICTION_POLICY=allkeys-lru
DEPLOY_COMPUTE_SIZE=flex-512mb

DEPLOY_PUBLIC_DOMAIN=payout.disburse.cash
DEPLOY_DNS_PROVIDER=digitalocean
DEPLOY_DNS_ZONE=disburse.cash
DEPLOY_DNS_NAMESERVERS_PRESERVED=true
DEPLOY_DIGITALOCEAN_REGION=sgp1
DEPLOY_DIGITALOCEAN_SPACE=REPLACE_WITH_EXISTING_PRIVATE_SPACE
DEPLOY_EVIDENCE_PREFIX=x-payout/active/REPLACE_WITH_STABLE_INSTANCE_ID

# Required retirement/cutover evidence. These values document the boundary;
# the installer does not invent or infer them from provider history.
DEPLOY_PROVIDER_CUTOVER_AT=REPLACE_WITH_ISO_8601_TIMESTAMP
DEPLOY_PROVIDER_CUTOVER_TRANSACTION_ID=REPLACE_WITH_LAST_RETIRED_PROVIDER_TRANSACTION

# -----------------------------------------------------------------------------
# Laravel runtime — non-secret values applied to the Cloud environment.
# Database and Redis connection values are injected by Laravel Cloud resources.
# -----------------------------------------------------------------------------
APP_NAME="x-PayOut"
APP_ENV=production
APP_DEBUG=false
# First use the generated Laravel Cloud URL and complete acceptance there.
# Before the domain cutover, replace this with https://payout.disburse.cash,
# rerun `configure --apply`, and redeploy once.
APP_URL=REPLACE_WITH_CURRENT_LARAVEL_CLOUD_URL
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=info

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3

AWS_DEFAULT_REGION=sgp1
AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com
AWS_BUCKET=REPLACE_WITH_EXISTING_PRIVATE_SPACE
AWS_USE_PATH_STYLE_ENDPOINT=false

XCHANGE_DEPLOYMENT_PROFILE=netbank
XCHANGE_RUNTIME_TIER=production
XCHANGE_INSTANCE_ID=REPLACE_WITH_STABLE_INSTANCE_ID
XCHANGE_CLAIM_EVIDENCE_DISK=s3
XCHANGE_CLAIM_EVIDENCE_DIRECTORY=x-payout/active/REPLACE_WITH_STABLE_INSTANCE_ID/claim-evidence
XCHANGE_INSTANCE_KEEPSAKE_DISK=s3
XCHANGE_INSTANCE_KEEPSAKE_DIRECTORY=x-payout/active/REPLACE_WITH_STABLE_INSTANCE_ID/instance-keepsakes
XCHANGE_INSTANCE_KEEPSAKE_DOWNLOAD_TTL_MINUTES=30

XCHANGE_SYSTEM_USER_COLUMN=email
XCHANGE_SYSTEM_USER_ID=system@x-payout.test
XCHANGE_COMMERCIAL_BILLING_MODE=billable
XCHANGE_COMMERCIAL_PRINCIPAL_REFERENCE=commercial-primary
XCHANGE_COMMERCIAL_PRINCIPAL_LEGAL_NAME="3neti R&D OPC"
XCHANGE_COMMERCIAL_PRINCIPAL_AUTHORIZATION_REFERENCE=commissioning:x-payout:commercial-principal:v1
XCHANGE_COMMERCIAL_REVENUE_ACCOUNT_SLUG=commercial-revenue
XCHANGE_COMMERCIAL_LEGAL_ENFORCEMENT=advisory
XCHANGE_TREASURY_LEGAL_ENTITY_REFERENCE=legal-entity:3neti-rnd-opc
XCHANGE_TREASURY_LEGAL_PROFILE_VERSION=2026-01

# Keep public money acceptance closed until generated-domain acceptance passes.
XCHANGE_ON_DEMAND_ISSUANCE_ENABLED=true
XCHANGE_ON_DEMAND_FUNDING_BASIS=full_amount
XCHANGE_ON_DEMAND_FIXED_QR_PH_ENABLED=true
XCHANGE_ON_DEMAND_NETBANK_QR_MODE=direct_qr
XCHANGE_ON_DEMAND_AUTOMATIC_VERIFICATION_ENABLED=true
XCHANGE_ON_DEMAND_EXPIRY_SCHEDULED_ENABLED=true
XCHANGE_PUBLIC_AUTO_GENERATE_ENABLED=false
XCHANGE_PUBLIC_AUTO_GENERATE_MINIMUM_PRINCIPAL_MINOR=100
XCHANGE_PUBLIC_AUTO_GENERATE_MAXIMUM_PRINCIPAL_MINOR=100000
XCHANGE_PUBLIC_AUTO_GENERATE_CURRENCIES=PHP

XCHANGE_MOBILE_VERIFICATION_ENABLED=true
XCHANGE_ONBOARDING_REQUIRE_OTP=true
XCHANGE_ONBOARDING_REQUIRE_PIN_SETUP=true
XCHANGE_IDENTITY_OTP_DRIVER=txtcmdr
XCHANGE_WITHDRAWAL_OTP_DRIVER=netbank

XCHANGE_REDEMPTION_FEEDBACK_ENABLED=true
XCHANGE_REDEMPTION_FEEDBACK_QUEUE=x-change-feedback
XCHANGE_CAMPAIGNS_EMAIL_DELIVERY_ENABLED=false
XCHANGE_CAMPAIGNS_SMS_DELIVERY_ENABLED=false
X_FEEDBACK_SMS_DRIVER=engagespark
X_FEEDBACK_SMS_SENDER=XCHANGE

XCHANGE_FUNDING_BROADCAST_ENABLED=false
XCHANGE_FUNDING_LIQUIDITY_SCHEDULED_REFRESH_ENABLED=true
XCHANGE_COMMERCIAL_LIVE_PROVIDER_CALLS_ENABLED=false
XCHANGE_COMMERCIAL_OPERATIONS_QUEUE=x-change-funding
XCHANGE_COMMERCIAL_SCHEDULED_RECONCILIATION_ENABLED=true
XCHANGE_PARTNER_API_ENABLED=false
XCHANGE_PARTNER_API_PUBLIC_DISCOVERY_ENABLED=true

# Opening capitalization is a separate commissioning authority. Change both
# values only for the one approved cleanroom commissioning run.
XCHANGE_TREASURY_OPENING_CAPITALIZATION_ALLOW_PRODUCTION=false
XCHANGE_TREASURY_OPENING_CAPITALIZATION_ALLOWED_CONNECTIONS=netbank-primary

NETBANK_FUNDING_API_URL=https://api.netbank.ph
NETBANK_FUNDING_QR_ENDPOINT=https://api.netbank.ph/v1/qrph/generate
NETBANK_FUNDING_TOKEN_URL=https://auth.netbank.ph/oauth2/token
NETBANK_FUNDING_CORPORATE_ACCOUNT_NAME="x-PayOut Treasury"
NETBANK_FUNDING_QR_MERCHANT_CITY=Manila
NETBANK_FUNDING_QR_MERCHANT_NAME=x-PayOut
NETBANK_BALANCE_ENDPOINT=REPLACE_WITH_NETBANK_BALANCE_ENDPOINT
NETBANK_CLIENT_ALIAS=REPLACE_WITH_NETBANK_CLIENT_ALIAS
NETBANK_DISBURSEMENT_ENDPOINT=REPLACE_WITH_NETBANK_DISBURSEMENT_ENDPOINT
NETBANK_FUNDING_BALANCE_ENDPOINT=REPLACE_WITH_NETBANK_FUNDING_BALANCE_ENDPOINT
NETBANK_FUNDING_CORPORATE_ACCOUNT_NUMBER=REPLACE_WITH_NETBANK_FUNDING_CORPORATE_ACCOUNT_NUMBER
NETBANK_FUNDING_STANDING_HMAC_KEY_ID=REPLACE_WITH_NETBANK_FUNDING_STANDING_HMAC_KEY_ID
NETBANK_FUNDING_VCA_ALIAS=REPLACE_WITH_NETBANK_FUNDING_VCA_ALIAS
NETBANK_QR_ENDPOINT=REPLACE_WITH_NETBANK_QR_ENDPOINT
NETBANK_SENDER_CUSTOMER_ID=REPLACE_WITH_NETBANK_SENDER_CUSTOMER_ID
NETBANK_SOURCE_ACCOUNT_NUMBER=REPLACE_WITH_NETBANK_SOURCE_ACCOUNT_NUMBER
NETBANK_STATUS_ENDPOINT=REPLACE_WITH_NETBANK_STATUS_ENDPOINT
NETBANK_TOKEN_ENDPOINT=REPLACE_WITH_NETBANK_TOKEN_ENDPOINT
NETBANK_TEST_MODE=false
USE_OMNIPAY=true

# Public verification material is configuration, not a credential.
XCHANGE_INSTANCE_KEEPSAKE_PUBLIC_KEY=REPLACE_WITH_KEEPSAKE_PUBLIC_KEY

TXTCMDR_API_URL=https://txtcmdr.example.com
HYPERVERGE_BASE_URL=https://ind.idv.hyperverge.co/v1
HYPERVERGE_URL_WORKFLOW=onboarding
KYC_USE_FAKE=false
LOCATION_HANDLER_MAP_PROVIDER=mapbox

# -----------------------------------------------------------------------------
# Laravel Cloud managed-secret inventory — values are intentionally absent.
# Attach their secret IDs through DEPLOY_CLOUD_SECRET_IDS. The continuous gate
# verifies every name in DEPLOY_REQUIRED_CLOUD_SECRET_NAMES before deployment.
# -----------------------------------------------------------------------------
# APP_KEY is generated and managed by Laravel Cloud. Never copy it here or
# into the one-time re-entry worksheet.
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# ENGAGESPARK_API_KEY
# ENGAGESPARK_ORGANIZATION_ID
# TXTCMDR_API_TOKEN
# HYPERVERGE_APP_ID
# HYPERVERGE_APP_KEY
# MAPBOX_TOKEN
# OPENCAGE_API_KEY
# NETBANK_CLIENT_ID
# NETBANK_CLIENT_SECRET
# NETBANK_FUNDING_CLIENT_ID
# NETBANK_FUNDING_CLIENT_SECRET
# NETBANK_FUNDING_STANDING_HMAC_KEY
# XCHANGE_COMMISSIONING_ACCESS_TOKEN
# XCHANGE_REDEMPTION_FEEDBACK_WEBHOOK_SECRET
