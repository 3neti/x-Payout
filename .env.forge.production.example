# x-PayOut Forge deployment-control worksheet
#
# Copy this file to .env.forge.production on the Forge site. The destination
# is gitignored. Application runtime values and credentials remain in the
# site's Forge-managed .env file; do not duplicate secrets here.

FORGE_CONFIRM_PRODUCTION=NO
FORGE_CONFIRM_COMMISSIONING=NO

FORGE_SITE_PATH=/home/forge/payout.disburse.cash
FORGE_SITE_BRANCH=main
FORGE_SOURCE_UPDATE_ENABLED=true
FORGE_PHP=php
FORGE_COMPOSER=composer
FORGE_DEPLOY_LOCK_FILE=/tmp/x-payout-production-deploy.lock

# Optional exact-version assertion. Keep synchronized with composer.lock.
FORGE_EXPECTED_XCHANGE_VERSION=v1.0.98

# Required only for the separately authorized, one-time commission phase.
FORGE_PROVIDER_CUTOVER_AT=REPLACE_WITH_ISO_8601_TIMESTAMP
FORGE_PROVIDER_CUTOVER_TRANSACTION_ID=REPLACE_WITH_LAST_RETIRED_PROVIDER_TRANSACTION
