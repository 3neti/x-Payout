APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# >>> 3neti/x-change managed environment >>>
# Generated documentation. Configure real values in your deployment environment.
# Secrets are intentionally blank. Do not paste credentials into this file.

# Delivery
# EngageSpark API key when its SMS transport is enabled.
ENGAGESPARK_API_KEY=
# EngageSpark organization identifier when its SMS transport is enabled.
ENGAGESPARK_ORGANIZATION_ID=
# Approved EngageSpark sender identifier.
ENGAGESPARK_SENDER_ID=XCHANGE
# Mailgun sending domain when the Mailgun mailer is enabled.
MAILGUN_DOMAIN=
# Mailgun API secret when the Mailgun mailer is enabled.
MAILGUN_SECRET=
# Resend API key when the Resend mailer is enabled.
RESEND_KEY=
# Permit explicit campaign email delivery actions.
XCHANGE_CAMPAIGNS_EMAIL_DELIVERY_ENABLED=false
# Permit explicit campaign SMS delivery actions.
XCHANGE_CAMPAIGNS_SMS_DELIVERY_ENABLED=false
# Enable explicit redemption feedback orchestration.
XCHANGE_REDEMPTION_FEEDBACK_ENABLED=true
# Dedicated queue for settlement feedback delivery.
XCHANGE_REDEMPTION_FEEDBACK_QUEUE=x-change-feedback
# Shared secret for configured redemption feedback webhooks.
XCHANGE_REDEMPTION_FEEDBACK_WEBHOOK_SECRET=
# x-feedback SMS transport driver.
X_FEEDBACK_SMS_DRIVER=log
# Public SMS sender label assigned by the configured transport.
X_FEEDBACK_SMS_SENDER=XCHANGE

# Evidence Storage
# S3-compatible private object-storage endpoint when required.
AWS_ENDPOINT=
# Purpose-bound directory prefix for private claimant evidence artifacts.
XCHANGE_CLAIM_EVIDENCE_DIRECTORY=x-change/claim-evidence
# Private filesystem disk used for claimant evidence artifacts; staging and production require a durable non-local driver.
XCHANGE_CLAIM_EVIDENCE_DISK=local
# Reset-independent private directory prefix for encrypted instance keepsakes.
XCHANGE_INSTANCE_KEEPSAKE_DIRECTORY=x-change/instance-keepsakes
# Private durable filesystem disk used for encrypted instance keepsake archives.
XCHANGE_INSTANCE_KEEPSAKE_DISK=local
# Minutes an authenticated one-time keepsake download grant remains usable.
XCHANGE_INSTANCE_KEEPSAKE_DOWNLOAD_TTL_MINUTES=30
# Base64 Sodium recipient public key; the matching private key must remain outside Cloud.
XCHANGE_INSTANCE_KEEPSAKE_PUBLIC_KEY=

# Identity
# Scoped bearer token allowed to create and verify OTP challenges.
TXTCMDR_API_TOKEN=
# Base URL of the versioned txtcmdr OTP challenge API.
TXTCMDR_API_URL=https://txtcmdr.example.com
# Provider-neutral OTP gateway used only for claimant identity verification.
XCHANGE_IDENTITY_OTP_DRIVER=txtcmdr
# Require verified mobile ownership during production onboarding.
XCHANGE_MOBILE_VERIFICATION_ENABLED=false
# Require OTP for onboarding vouchers.
XCHANGE_ONBOARDING_REQUIRE_OTP=false
# Require invited Accounts to choose a PIN before entering Cockpit.
XCHANGE_ONBOARDING_REQUIRE_PIN_SETUP=true
# Stable lookup column used for the system principal.
XCHANGE_SYSTEM_USER_COLUMN=email
# Stable email of the non-interactive system principal.
XCHANGE_SYSTEM_USER_ID=

# Instruction Services
# Server-only Google Maps key when Google renders Location evidence.
GOOGLE_MAPS_API_KEY=
# Server-only HyperVerge application identifier.
HYPERVERGE_APP_ID=
# Server-only HyperVerge application key.
HYPERVERGE_APP_KEY=
# HyperVerge identity-verification API base URL.
HYPERVERGE_BASE_URL=https://ind.idv.hyperverge.co/v1
# Approved HyperVerge workflow used for claimant KYC.
HYPERVERGE_URL_WORKFLOW=onboarding
# Use simulated KYC evidence in non-production environments only.
KYC_USE_FAKE=false
# Static-map provider used for durable Location evidence.
LOCATION_HANDLER_MAP_PROVIDER=mapbox
# Server-only Mapbox token when Mapbox renders Location evidence.
MAPBOX_TOKEN=
# Server-only OpenCage key used to reverse-geocode claim coordinates.
OPENCAGE_API_KEY=
# Comma-separated instruction services that must be ready for this deployment.
XCHANGE_REQUIRED_INSTRUCTION_CAPABILITIES=location,otp

# NetBank
# NetBank balance endpoint.
NETBANK_BALANCE_ENDPOINT=
# NetBank five-digit VCA alias.
NETBANK_CLIENT_ALIAS=
# NetBank OAuth client identifier.
NETBANK_CLIENT_ID=
# NetBank OAuth client secret.
NETBANK_CLIENT_SECRET=
# NetBank disbursement endpoint.
NETBANK_DISBURSEMENT_ENDPOINT=
# Optional NetBank funding API base URL override.
NETBANK_FUNDING_API_URL=https://api.netbank.ph
# Optional NetBank funding balance endpoint override.
NETBANK_FUNDING_BALANCE_ENDPOINT=
# Optional NetBank funding OAuth client identifier override.
NETBANK_FUNDING_CLIENT_ID=
# Optional NetBank funding OAuth client secret override.
NETBANK_FUNDING_CLIENT_SECRET=
# NetBank corporate settlement account display name.
NETBANK_FUNDING_CORPORATE_ACCOUNT_NAME=X Change Treasury
# Optional NetBank corporate settlement account override.
NETBANK_FUNDING_CORPORATE_ACCOUNT_NUMBER=
# Optional NetBank QR Ph generation endpoint override.
NETBANK_FUNDING_QR_ENDPOINT=https://api.netbank.ph/v1/qrph/generate
# QR Ph merchant city.
NETBANK_FUNDING_QR_MERCHANT_CITY=Manila
# QR Ph merchant label.
NETBANK_FUNDING_QR_MERCHANT_NAME=X Change
# Standing-address HMAC secret required by the HMAC address scheme.
NETBANK_FUNDING_STANDING_HMAC_KEY=
# Standing-address HMAC key identifier required by the HMAC address scheme.
NETBANK_FUNDING_STANDING_HMAC_KEY_ID=
# Optional NetBank funding OAuth token URL override.
NETBANK_FUNDING_TOKEN_URL=https://auth.netbank.ph/oauth2/token
# Optional NetBank funding VCA alias override.
NETBANK_FUNDING_VCA_ALIAS=
# NetBank QR Ph generation endpoint.
NETBANK_QR_ENDPOINT=
# NetBank sender customer identifier.
NETBANK_SENDER_CUSTOMER_ID=
# NetBank source and corporate settlement account.
NETBANK_SOURCE_ACCOUNT_NUMBER=
# NetBank transaction status endpoint.
NETBANK_STATUS_ENDPOINT=
# Use NetBank test-mode request behavior outside production.
NETBANK_TEST_MODE=false
# NetBank OAuth token endpoint.
NETBANK_TOKEN_ENDPOINT=
# Use the provider-only NetBank disbursement gateway. Disable only for a controlled legacy rollback.
USE_OMNIPAY=true

# Partner API
# OAuth signing private key when deployment storage does not retain oauth-private.key.
PASSPORT_PRIVATE_KEY=
# OAuth signing public key paired with PASSPORT_PRIVATE_KEY.
PASSPORT_PUBLIC_KEY=
# Public contact address for approved Partner API access requests.
XCHANGE_PARTNER_API_ACCESS_CONTACT=api-access@example.test
# Activate the governed OAuth Partner API after credentials and mandates are provisioned.
XCHANGE_PARTNER_API_ENABLED=false
# Publish sanitized OAuth, OpenAPI, and AI discovery without enabling financial operations.
XCHANGE_PARTNER_API_PUBLIC_DISCOVERY_ENABLED=true

# Paynamics
# Paynamics Constellation API base URL.
CONSTELLATION_BASE_URL=https://asterism.payserv.net/v1
# Paynamics funding cancellation URL.
CONSTELLATION_FUNDING_CANCEL_URL=https://example.test/x/funding/paynamics/cancel
# Paynamics funding payment channel.
CONSTELLATION_FUNDING_PAYMENT_CHANNEL=ubp_online
# Paynamics funding payment method.
CONSTELLATION_FUNDING_PAYMENT_METHOD=onlinebanktransfer
# Paynamics funding response URL.
CONSTELLATION_FUNDING_RESPONSE_URL=https://example.test/x/funding/paynamics/return
# Paynamics funding wallet identifier.
CONSTELLATION_FUNDING_WALLET_ID=
# Paynamics merchant signing key.
CONSTELLATION_MERCHANT_KEY=
# Public Paynamics notification URL.
CONSTELLATION_NOTIFICATION_URL=https://example.test/webhooks/paynamics
# Paynamics API password.
CONSTELLATION_PASSWORD=
# Paynamics revenue wallet identifier.
CONSTELLATION_REVENUE_WALLET_ID=
# Paynamics settlement wallet identifier.
CONSTELLATION_SETTLEMENT_WALLET_ID=
# Paynamics API username.
CONSTELLATION_USERNAME=

# Payout Authorization
# Separate provider authorization driver used by payout workflows.
XCHANGE_WITHDRAWAL_OTP_DRIVER=paynamics

# Runtime
# Broadcast confirmed funding changes to authenticated Cockpit clients.
XCHANGE_FUNDING_BROADCAST_ENABLED=false
# Refresh the cached provider-liquidity guard every five minutes.
XCHANGE_FUNDING_LIQUIDITY_SCHEDULED_REFRESH_ENABLED=true

# Treasury
# Legal trace enforcement mode for Commercial Offering publication.
XCHANGE_COMMERCIAL_LEGAL_ENFORCEMENT=advisory
# Permit independently approved Commercial Operations to submit real provider payouts.
XCHANGE_COMMERCIAL_LIVE_PROVIDER_CALLS_ENABLED=false
# Dedicated queue used by Commercial Operations provider reconciliation.
XCHANGE_COMMERCIAL_OPERATIONS_QUEUE=x-change-funding
# Queue provider status checks for previously submitted commission payouts.
XCHANGE_COMMERCIAL_SCHEDULED_RECONCILIATION_ENABLED=true
# Use maker-checker approved Commercial Offerings instead of package bootstrap pricing.
XCHANGE_COMMERCIAL_USE_PUBLISHED_OFFERINGS=false
# Stable legal-entity reference used by Treasury positions.
XCHANGE_TREASURY_LEGAL_ENTITY_REFERENCE=legal-entity:example
# Approved legal vocabulary profile version.
XCHANGE_TREASURY_LEGAL_PROFILE_VERSION=2026-01

# X-Change
# Expose the authenticated System Readiness workspace before role-based access is enabled.
XCHANGE_COCKPIT_SYSTEM_READINESS_VISIBLE=false
# Secret used to unlock the server commissioning checklist.
XCHANGE_COMMISSIONING_ACCESS_TOKEN=
# Explicit provider deployment profile. Required for this profile.
XCHANGE_DEPLOYMENT_PROFILE=development
# Runtime durability tier, independent from the selected provider topology. Required for this profile.
XCHANGE_RUNTIME_TIER=local
# <<< 3neti/x-change managed environment <<<
