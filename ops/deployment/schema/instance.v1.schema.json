{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3neti.example/schemas/x-payout/instance.v1.schema.json",
  "title": "x-PayOut portable instance profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "release", "public", "features", "providers", "storage", "commissioning"],
  "properties": {
    "schema": { "const": "x-payout.instance.v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "legal_name", "display_name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "legal_name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "cloud_source_branch"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "cloud_source_branch": { "type": "string", "minLength": 1 }
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_url", "locale", "currencies"],
      "properties": {
        "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "locale": { "type": "string", "minLength": 1 },
        "currencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "features": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "runtime": { "$ref": "#/$defs/environment" },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "connections"],
      "properties": {
        "active": { "type": "string", "minLength": 1 },
        "connections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "driver", "currency", "capabilities"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "driver": { "type": "string", "minLength": 1 },
              "currency": { "type": "string", "minLength": 3 },
              "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "runtime": { "$ref": "#/$defs/environment" },
              "secrets": { "$ref": "#/$defs/secretReferences" }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence"],
      "properties": {
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver"],
          "properties": {
            "driver": { "type": "string", "minLength": 1 },
            "runtime": { "$ref": "#/$defs/environment" },
            "secrets": { "$ref": "#/$defs/secretReferences" }
          }
        }
      }
    },
    "commissioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening", "commercial_principal", "invitations"],
      "properties": {
        "opening": { "type": "object" },
        "commercial_principal": { "type": "object" },
        "invitations": { "type": "object" }
      }
    },
    "secret_refs": { "$ref": "#/$defs/secretReferences" }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "secretReferences": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    }
  }
}
